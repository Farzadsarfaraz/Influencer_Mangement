# syntax=docker/dockerfile:1

FROM node:24-alpine AS base
WORKDIR /app
RUN corepack disable

FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci

FROM base AS runner
ENV NODE_ENV=production
# "server-only" (imported throughout lib/) only resolves to its no-op build
# via the "react-server" export condition, which Next.js's bundler sets
# automatically. The worker runs as a plain Node process outside that
# bundler, so it has to opt in to the same condition itself — see
# vitest.config.mts for the equivalent fix on the test side.
ENV NODE_OPTIONS=--conditions=react-server

RUN addgroup --system --gid 1001 nodejs \
  && adduser --system --uid 1001 worker

COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json prisma.config.ts ./
COPY prisma ./prisma
COPY lib ./lib
COPY worker ./worker
COPY types ./types

# DATABASE_URL is build-time only, scoped to this one command (not a
# persistent ENV) — prisma.config.ts resolves it eagerly just to load, even
# for `generate`, which never actually connects. The real value comes from
# the container's runtime env, set at `docker run`/deploy time.
RUN DATABASE_URL=postgresql://octagon:octagon@localhost:5432/octagon npx prisma generate

USER worker
CMD ["npx", "tsx", "worker/index.ts"]
